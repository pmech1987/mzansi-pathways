{
  "schemaVersion": 1,
  "recommendedAuth": "email_6digit_otp_plus_optional_passkey_or_password",
  "provider": "Supabase Auth (never custom DIY password hashing)",
  "otp": {
    "digits": 6,
    "expirySeconds": 600,
    "maxVerifyAttempts": 5,
    "rateLimitPer15Min": 3,
    "neverLogOtp": true
  },
  "session": {
    "httpOnlyRefreshCookies": true,
    "accessTokenTtlMinutes": 15,
    "requireGuardianConsentUnder18": true,
    "requireSaIdNumber": false
  }
}